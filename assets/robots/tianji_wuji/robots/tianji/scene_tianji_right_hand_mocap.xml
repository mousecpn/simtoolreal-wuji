<?xml version='1.0' encoding='utf-8'?>
<mujoco model="tianji_right_hand_mocap">
  <!-- ================================================================
       Tianji task scene with Wuji right hand only (mocap+weld wrist)
       Bypasses the 7-DOF Tianji arm: wrist pose commands go directly
       to the mocap body, the hand follows via weld constraint.
       Task setup (table, bin, objects, pole) matches scene_tianji_right_arm_hand.xml.
       ================================================================ -->

  <compiler angle="radian" meshdir="wuji_hand_sim_infra/meshes/"/>
  <option integrator="implicitfast" timestep="0.001" impratio="5"
          iterations="50" noslip_iterations="5">
    <flag multiccd="enable"/>
  </option>
  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="2048"/>
    <global azimuth="180" elevation="-30"/>
  </visual>
  <default>
    <joint armature="0.001" damping="0.05" frictionloss="0.01"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>

    <!-- Right Wuji hand meshes -->
    <mesh name="right_palm_link" file="right/right_palm_link.STL"/>
